{
  "name": "dsh-radio-dock",
  "version": "0.1.1",
  "description": "把 godot_citys 里的车载电台搬进 DSH 右侧栏：three.js 车内视角 + 会弯的夜路 + radio-browser 网络电台（City Pop）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "radio",
    "sidebar",
    "three.js",
    "city-pop"
  ],
  "author": "lemonhall",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lemonhall/dsh-radio-dock.git"
  },
  "homepage": "https://github.com/lemonhall/dsh-radio-dock#readme",
  "bugs": {
    "url": "https://github.com/lemonhall/dsh-radio-dock/issues"
  },
  "meta": {
    "title": "车载电台（City Pop）",
    "description": "右侧栏一个 tab：three.js 的车内视角在夜路上一直开，电台从 radio-browser 取频道，可以开关、切台、存快捷槽。"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
